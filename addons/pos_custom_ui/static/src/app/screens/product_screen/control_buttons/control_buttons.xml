<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_custom_ui.ControlButtons" t-inherit="point_of_sale.ControlButtons" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('course-btn')]" position="replace"/>
    </t>
    <t t-name="pos_custom_ui.ControlButton" t-inherit="point_of_sale.controlButton" t-inherit-mode="extension">
        <xpath expr="//button" position="attributes">
            <attribute name="t-att-disabled">
                disabled || (this.pos.cashier?._role !== 'manager' &amp;&amp; (btnClasses?.includes('js_discount') || btnClasses?.includes('o_pricelist_button')))
            </attribute>
        </xpath>
    </t>
</templates>