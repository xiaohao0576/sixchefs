<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_custom_ui.ActionpadWidget" t-inherit="point_of_sale.ActionpadWidget" t-inherit-mode="extension">
        <xpath expr="//button[hasclass('pay-order-button')]" position="attributes">
            <attribute name="t-on-click">this.isSelfOrderTableOrder ? this.clickTransferOrder.bind(this) : this.props.actionToTrigger</attribute>
            <attribute name="t-out">this.customActionName</attribute>
            <attribute name="t-att-disabled">this.pos.cashier?._role !== 'manager'</attribute>
        </xpath>
    </t>
</templates>