<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_custom_ui.ProductCard" t-inherit="point_of_sale.ProductCard" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('product-img')]" position="replace"/>
        <xpath expr="//div[hasclass('product-name')]" position="replace">
            <div class="lh-sm product-name o_line_clamp"
                t-att-class="{
                    'no-image d-flex text-center w-100 flex-column': !this.props.imageUrl,
                    'mt-1': this.props.isComboPopup and !this.props.imageUrl,
                    'o_line_clamp_7': !this.props.imageUrl,
                }"
                t-attf-id="article_product_{{this.props.productId}}">
                <t t-if="!this.props.imageUrl and (this.props.product.name_cn or this.props.product.name_km)">
                    <span t-if="this.props.product.name_cn" t-out="this.props.product.name_cn"/>
                    <span t-if="this.props.product.name_km" t-out="this.props.product.name_km"/>
                </t>
                <t t-else="" t-out="this.props.name"/>
                <small class="product-unit-price text-muted">
                    (<t t-out="this.env.utils.formatCurrency(this.props.product.product_tmpl_id?.list_price ?? this.props.product.list_price ?? 0, this.env.services.pos.currency.id)"/> / <t t-out="this.props.product.uom_id?.name || ''"/>)
                </small>
            </div>
        </xpath>
        <xpath expr="//div[hasclass('product-content')]" position="after">
            <span t-if="!this.props.imageUrl and this.props.product.default_code"
                class="product-default-code position-absolute top-0 end-0"
                t-out="this.props.product.default_code"/>
        </xpath>
    </t>
</templates>