<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">
    <t t-name="pos_custom_ui.Orderline" t-inherit="point_of_sale.Orderline" t-inherit-mode="extension">
        <xpath expr="//span[hasclass('text-wrap')]" position="replace">
            <span class="text-wrap d-flex flex-column flex-grow-1 overflow-hidden">
                <t t-if="this.line.product_id.name_cn or this.line.product_id.name_km">
                    <span t-if="this.line.product_id.name_cn" class="text-break fw-semibold" t-out="this.line.product_id.name_cn"/>
                    <span t-if="this.line.product_id.name_km" class="text-break fw-semibold" t-out="this.line.product_id.name_km"/>
                </t>
                <t t-else="" t-out="vals.name"/>
                <small t-if="vals.attributeString" t-out="vals.attributeString" class="attribute-line fst-italic" />
            </span>
        </xpath>
    </t>
</templates>