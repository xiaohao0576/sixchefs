<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_pos_settle_due_wizard_form" model="ir.ui.view">
        <field name="name">pos.settle.due.wizard.form</field>
        <field name="model">pos.settle.due.wizard</field>
        <field name="arch" type="xml">
            <form string="Settle Due">
                <group>
                    <group>
                        <field name="partner_id"/>
                        <field name="session_id"/>
                        <field name="available_payment_method_ids" invisible="1"/>
                        <field name="payment_method_id" domain="[('id', 'in', available_payment_method_ids)]"/>
                    </group>
                    <group>
                        <field name="selected_due_total" readonly="1"/>
                        <field name="amount"/>
                        <field name="adjustment_amount" readonly="1"/>
                    </group>
                </group>

                <label for="selected_order_ids" string="Orders to Settle"/>
                <field name="selected_order_ids" widget="many2many_tags"/>

                <div class="alert alert-warning" role="alert" invisible="adjustment_amount == 0">
                    The amount differs from selected due total. The difference will be posted as a discount adjustment line.
                </div>

                <footer>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
